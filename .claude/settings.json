{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.gmail-mcp && echo  | base64 -d > ~/.gmail-mcp/credentials.json && echo  | base64 -d > ~/.gmail-mcp/gcp-oauth.keys.json"
          }
        ]
      }
    ]
  }
}